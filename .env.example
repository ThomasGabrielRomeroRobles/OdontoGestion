# Plantilla de variables de entorno (KB 08). Copiar a .env y completar. NUNCA commitear .env.
# Guía de ejecución local: README.md en la raíz.
# Perfil: dev para desarrollar con Vite (npm run dev); demo para la demo en un solo proceso (http://localhost:8080,
# jar construido con -PwithFrontend y datos de demo ficticios al arrancar con la base vacía).
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/odontogestion
DB_USER=odonto
DB_PASSWORD=
BOOTSTRAP_ODONTOLOGO_EMAIL=odontologo@consultorio.example
BOOTSTRAP_ODONTOLOGO_PASSWORD=
SESSION_TIMEOUT_MIN=30
SESSION_COOKIE_SECURE=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@consultorio.example
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=America/Argentina/Buenos_Aires
REMINDER_HOURS_BEFORE=24
PENDING_REQUEST_TTL_MIN=30
PUBLIC_RATE_LIMIT_PER_HOUR=5
NOTIFICATION_CHANNELS=EMAIL
# Intervalo del procesamiento del outbox de notificaciones (ISO-8601). Para la demo se recomienda PT1M,
# así los emails salen en menos de un minuto.
NOTIFICATION_POLL_INTERVAL=PT5M
